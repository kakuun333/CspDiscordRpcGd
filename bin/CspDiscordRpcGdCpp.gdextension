[configuration]

entry_symbol = "CspDiscordRpcGdCppEntryPoint"
compatibility_minimum = "4.1"

[libraries]

macos.debug = "res://bin/CspDiscordRpcGdCpp.macos.debug.universal.dylib"
macos.release = "res://bin/CspDiscordRpcGdCpp.macos.release.universal.dylib"
windows.debug.x86_64 = "res://bin/CspDiscordRpcGdCpp.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://bin/CspDiscordRpcGdCpp.windows.release.x86_64.dll"
linux.debug.x86_64 = "res://bin/CspDiscordRpcGdCpp.linux.debug.x86_64.so"
linux.release.x86_64 = "res://bin/CspDiscordRpcGdCpp.linux.release.x86_64.so"
; Repeat for other architectures to support arm64, rv64, etc.
